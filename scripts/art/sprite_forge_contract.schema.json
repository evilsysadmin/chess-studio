{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chess-studio.local/schemas/pawn-slug-sprite-forge-contract-v1.json",
  "title": "Pawn Slug Sprite Forge bank contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "quality_contract",
    "actor",
    "weapon",
    "cell",
    "parts",
    "animations"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "quality_contract": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "weapon": {
      "type": "string",
      "minLength": 1
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "columns",
          "rows"
        ],
        "properties": {
          "columns": {
            "type": "integer",
            "minimum": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "part",
          "row",
          "fps",
          "loop",
          "authored_frames",
          "slots"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "loop": {
            "type": "boolean"
          },
          "authored_frames": {
            "type": "integer",
            "minimum": 1
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "source_dir": {
            "type": "string",
            "minLength": 1
          },
          "allowed_detached_components": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
