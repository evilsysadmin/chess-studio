; Chess Football Godot POC
config_version=5

[application]
config/name="Chess Football POC"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_up={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_down={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
pass_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74)]}
shoot_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75)]}
switch_player={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
