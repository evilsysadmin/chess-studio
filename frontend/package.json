{
  "name": "chess-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke && npm run test:unit && npm run test:contract",
    "test:smoke": "node ../scripts/run_frontend_test_group.mjs smoke",
    "test:unit": "node ../scripts/run_frontend_test_group.mjs unit",
    "test:contract": "node ../scripts/run_frontend_test_group.mjs contract",
    "test:all": "node ../scripts/run_frontend_test_group.mjs all",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
