{
  "bucket": "chess-studio-assets",
  "locationHint": "weur",
  "storageClass": "Standard",
  "customDomain": "assets.chess-studio.shadowops.dpdns.org",
  "zoneName": "shadowops.dpdns.org",
  "minTls": "1.2",
  "disableR2Dev": true,
  "cors": {
    "origins": [
      "*"
    ],
    "methods": [
      "GET",
      "HEAD"
    ],
    "exposeHeaders": [
      "ETag",
      "Content-Length",
      "Content-Type",
      "Cache-Control"
    ],
    "maxAgeSeconds": 86400
  },
  "retention": {
    "enabled": true,
    "warningBytes": 5000000000,
    "targetBytes": 5500000000,
    "softLimitBytes": 7000000000,
    "minimumAgeDays": 7,
    "ephemeralMaxAgeDays": 1,
    "keepRollbackPerFamily": 1,
    "keepStagingRevisions": 1,
    "keepRuntimeRevisions": 2,
    "maxDeleteObjectsPerRun": 1000,
    "maxDeleteFractionPerRun": 0.7,
    "ephemeralPrefixes": [
      "_smoke/"
    ],
    "deprecatedPrefixes": [
      "deprecated/",
      "_deprecated/"
    ],
    "protectedPrefixes": [
      "pawn-slug-godot/matthias/pose-semantics-v1/",
      "pawn-slug-godot/matthias/continuity-repair/machinegun/run13/"
    ],
    "releaseBundles": [
      {
        "pointerKey": "pawn-slug-godot/current.json",
        "releasePrefix": "pawn-slug-godot/releases",
        "keepPreviousReleases": 1,
        "minimumAgeDays": 1
      },
      {
        "pointerKey": "chess-football-godot/current.json",
        "releasePrefix": "chess-football-godot/releases",
        "keepPreviousReleases": 1,
        "minimumAgeDays": 1
      }
    ]
  }
}
