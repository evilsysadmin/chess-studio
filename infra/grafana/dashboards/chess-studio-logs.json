{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Cómo usar este dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Acción primero.** Ajusta `selector` si tu stack Loki comparte logs con otros servicios (p. ej. `{service_name=\"chess-studio\"}`). Los 404 nuevos incluyen `request_path` normalizado para encontrar llamadas rotas sin guardar IDs ni query strings. Usa `request_id` para correlacionar un fallo con el traceback de Render."
      }
    },
    {
      "id": 2,
      "title": "Requests · 15 min",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | event=\"http_request\" [15m]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "404 · 1 h",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | event=\"http_request\" | status = 404 [1h]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "5xx · 1 h",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | event=\"http_request\" | status >= 500 [1h]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "title": "API p95 · 15 min",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "max(quantile_over_time(0.95, $selector | json | event=\"http_request\" | unwrap duration_ms | __error__=\"\" [15m]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP por status",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum by (status) (count_over_time($selector | json | event=\"http_request\" [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "p95 por ruta · top 10",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(10, quantile_over_time(0.95, $selector | json | event=\"http_request\" | unwrap duration_ms | __error__=\"\" [$__interval]) by (route))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "404 accionables · request_path",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(15, sum by (request_path) (count_over_time($selector | json | event=\"http_request\" | status = 404 | request_path != \"\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{request_path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 9,
      "title": "5xx por ruta",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(15, sum by (route) (count_over_time($selector | json | event=\"http_request\" | status >= 500 [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 10,
      "title": "Errores recientes · correlación",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector | json | event=\"http_request\" | status >= 400 | line_format \"status={{.status}} method={{.method}} route={{.route}} path={{.request_path}} latency={{.duration_ms}}ms release={{.client_release}} req={{.request_id}} trace={{.trace_id}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "title": "5xx por release",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(10, sum by (client_release) (count_over_time($selector | json | event=\"http_request\" | status >= 500 | client_release != \"\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{client_release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 12,
      "title": "Excepciones backend",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector | json | event=\"http_request\" | exception = true | line_format \"{{.status}} {{.method}} {{.route}} · {{.duration_ms}}ms · req={{.request_id}} · trace={{.trace_id}} · release={{.client_release}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 13,
      "title": "Frontend telemetry · 15 min",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | event=\"frontend_telemetry\" [15m]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Frontend telemetry · flujo reciente",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 6,
        "y": 38,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector | json | event=\"frontend_telemetry\" | line_format \"{{.event_type}} · {{.metric_name}}={{.value}} · {{.context}} · release={{.release}} · {{.error_name}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "chess-studio",
    "logs",
    "production",
