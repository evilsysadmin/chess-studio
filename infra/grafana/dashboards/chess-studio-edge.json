{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Qué mide este dashboard",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Cloudflare Free, sin métricas de pago.** Este dashboard sólo usa familias que mantenemos explícitamente en la allowlist Free de Chess Studio: salud del exporter, zonas Free omitidas de Analytics, Workers y estado de certificados. Las métricas de Zone Analytics/GraphQL (requests por zona/host, países, HTTP status, WAF/firewall, cache, colocation, hostname analytics, etc.) están deliberadamente fuera. Tráfico y seguridad reales viven en los dashboards de OTEL/Loki."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exporter Cloudflare · up",
      "description": "Salud del exporter Prometheus protegido. SIN DATOS significa scrape/exporter no observable.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "SIN DATOS",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "max(cloudflare_exporter_up)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Zonas Free · analytics omitidas",
      "description": "Número de zonas Free que el exporter omite deliberadamente de Cloudflare GraphQL Analytics.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "SIN DATOS"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "max(cloudflare_zones_skipped_free_tier)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exporter errors · 1 h",
      "description": "Errores del exporter Cloudflare durante la última hora.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum(increase(cloudflare_exporter_errors_total[1h])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Workers · requests/s",
      "description": "Requests de Workers por script. Métrica account-level; no depende de Zone Analytics de pago.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum by (script_name) (rate(cloudflare_worker_requests_total[$__rate_interval]))",
          "legendFormat": "{{script_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Workers · errors/s",
      "description": "Errores de Workers por script.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum by (script_name) (rate(cloudflare_worker_errors_total[$__rate_interval]))",
          "legendFormat": "{{script_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Certificados · estado",
      "description": "Estado de validación de certificados de zona. Requiere permiso read-only SSL and Certificates, disponible sin contratar Analytics de pago.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum by (status) (cloudflare_zone_certificate_validation_status)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "chess-studio",
    "cloudflare",
    "free-tier",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Chess Studio · Cloudflare Free",
  "uid": "chess-studio-edge",
  "version": 1,
  "weekStart": ""
}
