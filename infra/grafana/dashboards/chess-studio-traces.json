{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "chess-studio",
    "tempo",
    "traces",
    "sre",
    "terraform",
    "${commit_sha}"
  ],
  "timezone": "browser",
  "title": "Chess Studio · Trazas",
  "uid": "chess-studio-traces",
  "version": 1,
  "weekStart": "monday",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Tempo · trazas recientes",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource_uid}"
          },
          "query": "{ resource.service.name = \"chess-studio-backend\" }",
          "queryType": "traceql",
          "refId": "A",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Trazas lentas · >500 ms",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource_uid}"
          },
          "query": "{ resource.service.name = \"chess-studio-backend\" && duration > 500ms }",
          "queryType": "traceql",
          "refId": "A",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Trazas con error",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource_uid}"
          },
          "query": "{ resource.service.name = \"chess-studio-backend\" && status = error }",
          "queryType": "traceql",
          "refId": "A",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Logs correlacionables por trace_id",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "{} | json | trace_id != \"\" | line_format \"trace={{.trace_id}} · {{.status}} {{.method}} {{.route}} · req={{.request_id}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
