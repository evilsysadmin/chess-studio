      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum(rate(node_disk_read_bytes_total{service_name=\"chess-studio-oci-host\",deployment_environment=\"staging\"}[5m])) + sum(rate(node_disk_written_bytes_total{service_name=\"chess-studio-oci-host\",deployment_environment=\"staging\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "SIN DATOS"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "5xx · 15 min",
