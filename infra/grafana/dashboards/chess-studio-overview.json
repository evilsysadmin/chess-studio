    {
      "id": 6,
      "title": "HTTP por status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum by (http_response_status_class) (rate(chess_studio_http_server_requests_total{service_name=~\"${backend_service:regex}\"}[$__rate_interval])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "p95 por ruta",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "topk(8, 1000 * histogram_quantile(0.95, sum by (le, http_route) (rate(chess_studio_http_server_duration_seconds_bucket{service_name=~\"${backend_service:regex}\"}[$__rate_interval])))) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "5xx recientes",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "{service_name=~\"${backend_service:regex}\"} | json | event=\"http_request\" | status >= 500 | line_format \"{{.status}} {{.method}} {{.route}} · {{.duration_ms}}ms · req={{.request_id}} · trace={{.trace_id}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Trazas recientes · Tempo",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource_uid}"
      },
      "gridPos": {
        "x": 14,
        "y": 22,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource_uid}"
          },
          "query": "{ resource.service.name =~ \"${backend_service:regex}\" }",
          "queryType": "traceql",
          "refId": "A",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "SLO · 5xx % · 15 min",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "100 * (sum(increase(chess_studio_http_server_requests_total{service_name=~\"${backend_service:regex}\",http_response_status_class=\"5xx\"}[15m])) / clamp_min(sum(increase(chess_studio_http_server_requests_total{service_name=~\"${backend_service:regex}\"}[15m])), 1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ]
