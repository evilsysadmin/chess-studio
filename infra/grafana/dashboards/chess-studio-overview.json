    {
      "id": 3,
      "title": "404 · 1 h",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 6,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time({service_name=~\"${backend_service:regex}\"} | json | event=\"http_request\" | status = 404 [1h]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "p95 API · 15 min",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "(1000 * histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket{service_name=~\"${backend_service:regex}\"}[15m])))) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
