    {
      "id": 10,
      "type": "bargauge",
      "title": "Biggest offenders · 401/403/429",
      "description": "Top client_ip por respuestas de rechazo/limitación. La IP está saneada por el backend.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(15, sum by (client_ip) (count_over_time(${selector:raw} | json | __error__=\"\" | event=\"http_request\" | synthetic_source!=\"staging-smoke-cleanup\" | status=~\"401|403|429\" | client_ip != \"\" [$__range])))",
          "legendFormat": "{{client_ip}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
