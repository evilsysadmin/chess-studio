        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum(increase(cloudflare_zone_firewall_events_total{host=\"chess-studio.shadowops.dpdns.org\"}[15m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Presión de tráfico · requests/s vs baseline 1 h",
      "description": "Compara requests/s a 5 min con la media a 1 h. Un multiplicador alto es una señal a investigar, no una clasificación automática de DoS.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum(rate(cloudflare_zone_colocation_requests_total{host=\"chess-studio.shadowops.dpdns.org\"}[5m]))",
          "legendFormat": "actual · 5m",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource_uid}"
          },
          "expr": "sum(rate(cloudflare_zone_colocation_requests_total{host=\"chess-studio.shadowops.dpdns.org\"}[1h]))",
          "legendFormat": "baseline · 1h",
          "refId": "B"
        }
      ]
    },
