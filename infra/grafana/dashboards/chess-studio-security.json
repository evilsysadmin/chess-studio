        "type": "custom",
        "query": "production : chess-studio-(backend|oci-backend-production-stdout),staging : chess-studio-(backend-staging|oci-backend-staging-stdout)",
        "current": {
          "text": "production",
          "value": "chess-studio-(backend|oci-backend-production-stdout)"
        },
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": true,
        "allValue": "chess-studio-(backend(-staging)?|oci-backend-(production|staging)-stdout)",
        "multi": false
      }
    ]
  },
  "time": {
    "from": "now-3h",
