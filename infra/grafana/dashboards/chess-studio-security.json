    {
      "id": 10,
      "type": "bargauge",
      "title": "Biggest auth offenders · failed logins",
      "description": "Top client_ip por fallos reales de login en el entorno seleccionado. Excluye smokes firmados y el namespace técnico ci_smoke; los rechazos HTTP generales siguen visibles arriba.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(15, sum by (client_ip) (count_over_time({service_name=~\"${backend_service:raw}\"} | json | __error__=\"\" | event=\"auth_login_failed\" | synthetic_source!~\"staging-(smoke-cleanup|browser-smoke)\" | user_agent!=\"chess-studio-staging-smoke-cleanup/2\" | username_attempted!~\"ci_smoke_[0-9a-f]{16}\" | client_ip != \"\" [$__range])))",
          "legendFormat": "{{client_ip}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "IPs ofensivas únicas · por país",
      "description": "Ranking de IPs cliente distintas con fallos reales de login, agrupadas por país en el rango seleccionado. Respeta Entorno backend y excluye CI/smokes.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "topk(12, count by (client_country) (sum by (client_country, client_ip) (count_over_time({service_name=~\"${backend_service:raw}\"} | json | __error__=\"\" | event=\"auth_login_failed\" | synthetic_source!~\"staging-(smoke-cleanup|browser-smoke)\" | user_agent!=\"chess-studio-staging-smoke-cleanup/2\" | username_attempted!~\"ci_smoke_[0-9a-f]{16}\" | client_country != \"\" | client_ip != \"\" [$__range]))))",
          "instant": true,
          "legendFormat": "{{client_country}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Auth forensics reciente · sin contraseñas",
      "description": "Eventos auth_login_failed reales para correlacionar IP, país, usuario intentado, huella/forma de contraseña y user-agent. Smokes firmados y el namespace técnico ci_smoke quedan fuera de Security pero siguen disponibles en Log Explorer.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "{service_name=~\"${backend_service:raw}\"} | json | __error__=\"\" | event=\"auth_login_failed\" | synthetic_source!~\"staging-(smoke-cleanup|browser-smoke)\" | user_agent!=\"chess-studio-staging-smoke-cleanup/2\" | username_attempted!~\"ci_smoke_[0-9a-f]{16}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
