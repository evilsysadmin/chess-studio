          },
          "expr": "sum(count_over_time({service_name=~\"${backend_service:raw}\"} | json | __error__=\"\" | event=\"http_request\" | synthetic_source!~\"staging-(smoke-cleanup|browser-smoke)\" | status=\"401\" [$__interval]))",
          "legendFormat": "401",
