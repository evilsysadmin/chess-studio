  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Chess Studio · Log Explorer",
  "uid": "chess-studio-log-explorer",
  "version": 2,
  "weekStart": "monday",
  "panels": [
    {
      "id": 1,
      "title": "Cómo investigar",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Exploración sin tocar LogQL.** Los filtros de `route`, `path`, `release`, `request_id` y `trace_id` se aplican **después de `| json`**: no se convierten en labels de Loki y no crean cardinalidad explosiva. Usa `.*` para no filtrar. **Texto · regex** busca sobre la línea original. Para una incidencia: acota entorno/status/ruta → copia `request_id` para correlación → usa `trace_id` en **Trazas / Tempo**."
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 2,
      "title": "HTTP · coincidencias",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | __error__=\"\" | event=\"http_request\" | status=~\"$status\" | method=~\"$method\" | route=~\"$route\" | request_path=~\"$path\" | client_release=~\"$release\" | request_id=~\"$request_id\" | trace_id=~\"$trace_id\" |~ \"$text\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "HTTP · p95 filtrada",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "max(quantile_over_time(0.95, $selector | json | __error__=\"\" | event=\"http_request\" | status=~\"$status\" | method=~\"$method\" | route=~\"$route\" | request_path=~\"$path\" | client_release=~\"$release\" | request_id=~\"$request_id\" | trace_id=~\"$trace_id\" |~ \"$text\" | unwrap duration_ms | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "SIN DATOS"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Eventos estructurados · coincidencias",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "sum(count_over_time($selector | json | __error__=\"\" | event=~\"$event\" |~ \"$text\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "HTTP requests · filtradas",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector | json | __error__=\"\" | event=\"http_request\" | status=~\"$status\" | method=~\"$method\" | route=~\"$route\" | request_path=~\"$path\" | client_release=~\"$release\" | request_id=~\"$request_id\" | trace_id=~\"$trace_id\" |~ \"$text\" | line_format \"status={{.status}} method={{.method}} route={{.route}} path={{.request_path}} latency={{.duration_ms}}ms release={{.client_release}} req={{.request_id}} trace={{.trace_id}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "Eventos JSON · por tipo/texto",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector | json | __error__=\"\" | event=~\"$event\" |~ \"$text\" | line_format \"event={{.event}} status={{.status}} method={{.method}} route={{.route}} type={{.event_type}} release={{.client_release}}{{.release}} req={{.request_id}} trace={{.trace_id}} · {{.error_name}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Raw logs · texto/regex",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource_uid}"
          },
          "expr": "$selector |~ \"$text\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
