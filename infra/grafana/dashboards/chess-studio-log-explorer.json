  "templating": {
    "list": [
      {
        "name": "selector",
        "label": "Entorno",
        "type": "custom",
        "query": "production : {service_name=\"chess-studio-backend\"},staging : {service_name=\"chess-studio-backend-staging\"},production OCI stdout : {service_name=\"chess-studio-oci-backend-production-stdout\"},staging OCI stdout : {service_name=\"chess-studio-oci-backend-staging-stdout\"}",
        "current": {
          "text": "production",
          "value": "{service_name=\"chess-studio-backend\"}"
        },
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": true,
        "allValue": "{service_name=~\"chess-studio-(backend(-staging)?|oci-backend-(production|staging)-stdout)\"}",
        "multi": false
      },
      {
        "name": "event",
        "label": "Evento",
        "type": "custom",
        "query": "todos : .*,http_request : http_request,frontend_telemetry : frontend_telemetry",
        "current": {
          "text": "todos",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "query": "todos : .*,2xx : 2..,3xx : 3..,4xx : 4..,5xx : 5..",
        "current": {
          "text": "todos",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "method",
        "label": "Método",
