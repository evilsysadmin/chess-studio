{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "description": "Datasource Prometheus/Mimir de este stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Chess Studio · Salud de API",
  "description": "Tráfico, experiencia y dependencia de IA. Las métricas son agregadas y no contienen identidades ni contenido de partidas.",
  "uid": "chess-studio-api-overview",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad API core · 15 min",
      "description": "SLI de las rutas de juego y cuenta. Narrativa se mide aparte porque depende de Workers AI; los 4xx cuentan como API disponible.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_http_server_request_total{http_route!=\"/api/narrative\", http_response_status_class!~\"5xx|unknown\"}[15m])) / clamp_min(sum(rate(chess_studio_http_server_request_total{http_route!=\"/api/narrative\"}[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 99.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Latencia API core p95 · 15 min",
      "description": "Rutas de juego y cuenta, sin `/api/narrative`: la espera de Workers AI tiene su propia sección.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket{http_route!=\"/api/narrative\"}[15m])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 1.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Errores API core 5xx · 15 min",
      "description": "Fallos de servidor en rutas core; los problemas de narrativa se ven separados de la salud de la aplicación.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_http_server_request_total{http_route!=\"/api/narrative\", http_response_status_class=\"5xx\"}[15m])) / clamp_min(sum(rate(chess_studio_http_server_request_total{http_route!=\"/api/narrative\"}[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "title": "Usuarios concurrentes",
      "description": "Usuarios activos agregados en la ventana de presencia; no incluye identidades.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "last_over_time(chess_studio_presence_online_users[5m])" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin muestra" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "title": "Peticiones por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum(rate(chess_studio_http_server_request_total[5m])) * 60", "legendFormat": "total" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }
    },
    {
      "id": 6,
      "title": "Tráfico por familia de respuesta",
      "description": "Ayuda a separar errores de cliente, servidor y respuestas correctas.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (http_response_status_class) (rate(chess_studio_http_server_request_total[5m])) * 60", "legendFormat": "{{http_response_status_class}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }
    },
    {
      "id": 7,
      "title": "Rutas más visitadas · última hora",
      "description": "Volumen por ruta normalizada, sin parámetros ni identificadores de usuario.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (http_route) (increase(chess_studio_http_server_request_total[1h])))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 }
    },
    {
      "id": 8,
      "title": "p95 por ruta core · 15 min",
      "description": "Las rutas lentas de juego y cuenta; narrativa se separa para no ocultar la salud del producto.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (http_route, le) (rate(chess_studio_http_server_duration_seconds_bucket{http_route!=\"/api/narrative\"}[15m]))))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 }
    },
    {
      "id": 9,
      "title": "Rutas con errores 5xx · última hora",
      "description": "Sólo rutas normalizadas; úsalo como punto de partida para revisar logs y trazas.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (http_route) (increase(chess_studio_http_server_request_total{http_response_status_class=\"5xx\"}[1h])))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 }
    },
    {
      "id": 10,
      "title": "Latencia API core p95",
      "description": "Evolución de las rutas core; el SLI superior usa la misma fuente con ventana más larga.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket{http_route!=\"/api/narrative\"}[5m])))", "legendFormat": "core p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 }
    },
    {
      "id": 11,
      "title": "Narrativa / IA por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (ai_provider) (rate(chess_studio_ai_request_total[5m])) * 60", "legendFormat": "{{ai_provider}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 }
    },
    {
      "id": 12,
      "title": "Workers AI · cuota servida · 15 min",
      "description": "Proporción de respuestas narrativas atendidas por Cloudflare Workers AI.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_ai_request_total{ai_provider=\"cloudflare\"}[15m])) / clamp_min(sum(rate(chess_studio_ai_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin IA" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 80 }, { "color": "green", "value": 95 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 29 }
    },
    {
      "id": 13,
      "title": "Fallback local · 15 min",
      "description": "Porcentaje de narrativa resuelta por la alternativa local cuando Workers AI no responde.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_ai_request_total{ai_provider!=\"cloudflare\"}[15m])) / clamp_min(sum(rate(chess_studio_ai_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin IA" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 29 }
    },
    {
      "id": 14,
      "title": "Latencia de IA p95 por proveedor",
      "description": "Tiempo de la dependencia de narrativa, separado por Workers AI y fallback local.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (ai_provider, ai_channel, le) (rate(chess_studio_ai_duration_seconds_bucket[15m])))", "legendFormat": "{{ai_provider}} · {{ai_channel}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 }
    },
    {
      "id": 15,
      "title": "IA por canal",
      "description": "Volumen de narrativa por contexto, independiente del proveedor.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (ai_channel) (rate(chess_studio_ai_request_total[5m])) * 60", "legendFormat": "{{ai_channel}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 16,
      "title": "Narrativa end-to-end p95 · 15 min",
      "description": "Tiempo que percibe el jugador en `/api/narrative`, incluido Workers AI y la preparación de la respuesta.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket{http_route=\"/api/narrative\"}[15m])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin narrativa" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 45 }
    },
    {
      "id": 17,
      "title": "Workers AI p95 · 15 min",
      "description": "Sólo la llamada al proveedor Cloudflare; explica la mayor parte de la espera de narrativa cuando hay éxito.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_ai_duration_seconds_bucket{ai_provider=\"cloudflare\"}[15m])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin Workers AI" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1.5 }, { "color": "red", "value": 4 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 45 }
    },
    {
      "id": 18,
      "title": "Fallback local p95 · 15 min",
      "description": "Tiempo de la alternativa local cuando Workers AI no responde; acompáñalo del porcentaje de fallback.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_ai_duration_seconds_bucket{ai_provider=\"local\"}[15m])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin fallback" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 45 }
    }
  ]
}
