{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "description": "Datasource Prometheus/Mimir de este stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Chess Studio · Salud de API",
  "uid": "chess-studio-api-overview",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Peticiones por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum(rate(chess_studio_http_server_request_total[5m])) * 60", "legendFormat": "total" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Errores 5xx (%)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_http_server_request_total{http_response_status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(chess_studio_http_server_request_total[5m])), 0.001)", "legendFormat": "5xx" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Latencia HTTP p95",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Narrativa / IA por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (ai_provider) (rate(chess_studio_ai_request_total[5m])) * 60", "legendFormat": "{{ai_provider}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Rutas con más errores 5xx",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (http_route) (increase(chess_studio_http_server_request_total{http_response_status_class=\"5xx\"}[1h]))", "format": "table", "instant": true }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    }
  ]
}
