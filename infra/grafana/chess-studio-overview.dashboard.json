{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "description": "Datasource Prometheus/Mimir de este stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Chess Studio · Salud de API",
  "description": "Tráfico, experiencia y dependencia de IA. Las métricas son agregadas y no contienen identidades ni contenido de partidas.",
  "uid": "chess-studio-api-overview",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad SLI · 15 min",
      "description": "Porcentaje de respuestas que no son 5xx. Los 4xx se contabilizan como API disponible.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_http_server_request_total{http_response_status_class!~\"5xx|unknown\"}[15m])) / clamp_min(sum(rate(chess_studio_http_server_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 99.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Latencia HTTP p95 · 15 min",
      "description": "El 95% de las peticiones termina en este tiempo o menos.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket[15m])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 1.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Errores 5xx · 15 min",
      "description": "Fallos del servidor sobre el total de peticiones.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_http_server_request_total{http_response_status_class=\"5xx\"}[15m])) / clamp_min(sum(rate(chess_studio_http_server_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "title": "Usuarios concurrentes",
      "description": "Usuarios activos agregados en la ventana de presencia; no incluye identidades.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "last_over_time(chess_studio_presence_online_users[5m])" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin muestra" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "title": "Peticiones por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum(rate(chess_studio_http_server_request_total[5m])) * 60", "legendFormat": "total" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }
    },
    {
      "id": 6,
      "title": "Tráfico por familia de respuesta",
      "description": "Ayuda a separar errores de cliente, servidor y respuestas correctas.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (http_response_status_class) (rate(chess_studio_http_server_request_total[5m])) * 60", "legendFormat": "{{http_response_status_class}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }
    },
    {
      "id": 7,
      "title": "Rutas más visitadas · última hora",
      "description": "Volumen por ruta normalizada, sin parámetros ni identificadores de usuario.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (http_route) (increase(chess_studio_http_server_request_total[1h])))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 }
    },
    {
      "id": 8,
      "title": "p95 por ruta · 15 min",
      "description": "Las rutas más lentas para priorizar trabajo real de producto.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (http_route, le) (rate(chess_studio_http_server_duration_seconds_bucket[15m]))))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 }
    },
    {
      "id": 9,
      "title": "Rutas con errores 5xx · última hora",
      "description": "Sólo rutas normalizadas; úsalo como punto de partida para revisar logs y trazas.",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (http_route) (increase(chess_studio_http_server_request_total{http_response_status_class=\"5xx\"}[1h])))", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 }
    },
    {
      "id": 10,
      "title": "Latencia HTTP p95",
      "description": "Evolución de la latencia de la API; el SLI superior usa la misma fuente con ventana más larga.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(chess_studio_http_server_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 }
    },
    {
      "id": 11,
      "title": "Narrativa / IA por minuto",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (ai_provider) (rate(chess_studio_ai_request_total[5m])) * 60", "legendFormat": "{{ai_provider}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 }
    },
    {
      "id": 12,
      "title": "Workers AI · cuota servida · 15 min",
      "description": "Proporción de respuestas narrativas atendidas por Cloudflare Workers AI.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_ai_request_total{ai_provider=\"cloudflare\"}[15m])) / clamp_min(sum(rate(chess_studio_ai_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin IA" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 80 }, { "color": "green", "value": 95 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 29 }
    },
    {
      "id": 13,
      "title": "Fallback local · 15 min",
      "description": "Porcentaje de narrativa resuelta por la alternativa local cuando Workers AI no responde.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(chess_studio_ai_request_total{ai_provider!=\"cloudflare\"}[15m])) / clamp_min(sum(rate(chess_studio_ai_request_total[15m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "noValue": "Sin IA" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 29 }
    },
    {
      "id": 14,
      "title": "Latencia de IA p95 por canal",
      "description": "Compara la experiencia de narrativa por contexto de juego.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (ai_channel, le) (rate(chess_studio_ai_duration_seconds_bucket[15m])))", "legendFormat": "{{ai_channel}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 }
    },
    {
      "id": 15,
      "title": "IA por canal",
      "description": "Volumen de narrativa por contexto, independiente del proveedor.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{ "refId": "A", "expr": "sum by (ai_channel) (rate(chess_studio_ai_request_total[5m])) * 60", "legendFormat": "{{ai_channel}}" }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    }
  ]
}
