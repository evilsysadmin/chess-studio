apiVersion: v1
kind: Namespace
metadata:
  name: chess-studio-staging2
  labels:
    app.kubernetes.io/part-of: chess-studio
    chess-studio.shadowops/track: staging2
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: chess-studio-staging2
  labels:
    app.kubernetes.io/name: chess-studio-backend
    app.kubernetes.io/part-of: chess-studio
    chess-studio.shadowops/track: staging2
spec:
  replicas: 1
  revisionHistoryLimit: 2
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: chess-studio-backend
      chess-studio.shadowops/track: staging2
  template:
    metadata:
      labels:
        app.kubernetes.io/name: chess-studio-backend
        app.kubernetes.io/part-of: chess-studio
        chess-studio.shadowops/track: staging2
      annotations:
        chess-studio.shadowops/release: "__SHA__"
    spec:
      automountServiceAccountToken: false
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: backend
          image: ghcr.io/evilsysadmin/chess-studio-backend:oci-__SHA__
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: backend-runtime
          env:
            - name: GIT_COMMIT_SHA
              value: "__SHA__"
            - name: PORT
              value: "4000"
            - name: CORS_ORIGINS
              value: "https://staging2.chess-studio.shadowops.dpdns.org"
          ports:
            - name: http
              containerPort: 4000
              protocol: TCP
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 600m
              memory: 768Mi
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            capabilities:
              drop: ["ALL"]
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 15
            timeoutSeconds: 3
            failureThreshold: 4
          readinessProbe:
            httpGet:
              path: /api/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 12
---
apiVersion: v1
kind: Service
metadata:
  name: backend
  namespace: chess-studio-staging2
  labels:
    app.kubernetes.io/name: chess-studio-backend
    chess-studio.shadowops/track: staging2
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: chess-studio-backend
    chess-studio.shadowops/track: staging2
  ports:
    - name: http
      port: 4000
      targetPort: http
      protocol: TCP
