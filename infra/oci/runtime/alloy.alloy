// Chess Studio OCI staging host telemetry.
//
// The backend and this collector intentionally reuse the same Grafana Cloud
// OTLP gateway and Authorization header from /etc/chess-studio/backend.env.
// No extra Prometheus/Loki credentials or public listener are required.

prometheus.exporter.unix "oci_host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"

  // Keep the first host contract deliberately narrow: useful Linux health
  // signals without privileged mode, the Docker socket, or host rootfs access.
  set_collectors = [
    "cpu",
    "diskstats",
    "loadavg",
    "meminfo",
    "netdev",
    "pressure",
    "stat",
    "time",
    "uname",
    "vmstat",
  ]
}

prometheus.scrape "oci_host" {
  targets         = prometheus.exporter.unix.oci_host.targets
  scrape_interval = "30s"
  job_name        = "chess-studio-oci-host"
  forward_to      = [prometheus.relabel.oci_host.receiver]
}

prometheus.relabel "oci_host" {
  forward_to = [otelcol.receiver.prometheus.oci_host.receiver]

  rule {
    target_label = "deployment_environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "service_name"
    replacement  = "chess-studio-oci-host"
  }

  rule {
    target_label = "cloud_provider"
    replacement  = "oci"
  }

  rule {
    target_label = "cloud_region"
    replacement  = "eu-frankfurt-1"
  }

  rule {
    target_label = "service_version"
    replacement  = sys.env("GIT_COMMIT_SHA")
  }
}

// Meta-monitor the exact same OTLP delivery path. If this signal reaches Grafana
// while node_* does not, the transport is healthy and the host scrape is the
// remaining fault domain.
prometheus.exporter.self "alloy_self" {}

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy_self.targets
  scrape_interval = "30s"
  job_name        = "chess-studio-alloy-self"
  forward_to      = [prometheus.relabel.alloy_self.receiver]
}

prometheus.relabel "alloy_self" {
  forward_to = [otelcol.receiver.prometheus.oci_host.receiver]

  rule {
    target_label = "deployment_environment"
    replacement  = sys.env("ENVIRONMENT")
  }

  rule {
    target_label = "service_name"
    replacement  = "chess-studio-alloy-self"
  }

  rule {
    target_label = "cloud_provider"
    replacement  = "oci"
  }

  rule {
    target_label = "cloud_region"
    replacement  = "eu-frankfurt-1"
  }

  rule {
    target_label = "service_version"
    replacement  = sys.env("GIT_COMMIT_SHA")
  }
}

otelcol.receiver.prometheus "oci_host" {
  output {
    metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// Docker stdout stays inside a root-controlled Chess Studio scope.
// The deploy wrapper publishes exactly one backend symlink plus one short-lived
// Docker-json probe file. Alloy never receives the Docker socket and therefore
// gains no Docker control-plane privileges.
otelcol.storage.file "oci_backend_stdout" {}

otelcol.receiver.filelog "oci_backend_stdout" {
  include       = ["/var/lib/chess-studio/observability/*-json.log"]
  start_at      = "end"
  poll_interval = "500ms"
  storage       = otelcol.storage.file.oci_backend_stdout.handler

  operators = [{
    type = "container"
  }]

  resource = {
    "service.name"                 = sys.env("OCI_LOG_SERVICE_NAME")
    "deployment.environment.name" = sys.env("ENVIRONMENT")
    "cloud.provider"               = "oci"
    "cloud.region"                 = "eu-frankfurt-1"
    "service.version"              = sys.env("GIT_COMMIT_SHA")
  }

  retry_on_failure {
    enabled          = true
    max_elapsed_time = "5m"
  }

  output {
    logs = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// Grafana Cloud's OTEL_EXPORTER_OTLP_HEADERS value is normally a single
// Authorization header. Accept both a literal space and the standard %20 form
// emitted by OTLP environment-variable examples.
otelcol.auth.headers "grafana_cloud" {
  header {
    key = "Authorization"
    value = string.replace(
      string.trim_prefix(
        string.trim_prefix(sys.env("OTEL_EXPORTER_OTLP_HEADERS"), "Authorization="),
        "authorization=",
      ),
      "%20",
      " ",
    )
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    // Match backend-python/tracing.py endpoint recovery. The shared Vault value
    // should be a gateway base (normally .../otlp), but old values may carry one
    // signal-specific suffix. otlphttp appends /v1/metrics itself.
    endpoint = string.trim_suffix(
      string.trim_suffix(
        string.trim_suffix(
          string.trim_suffix(sys.env("OTEL_EXPORTER_OTLP_ENDPOINT"), "/"),
          "/v1/traces",
        ),
        "/v1/metrics",
      ),
      "/v1/logs",
    )
    auth        = otelcol.auth.headers.grafana_cloud.handler
    compression = "gzip"
  }
}
