#cloud-config
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - git
  - docker.io
  - python3-venv

write_files:
  - path: /usr/local/sbin/chess-studio-deploy
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      if [ "$#" -ne 1 ] || ! printf '%s' "$1" | grep -Eq '^[0-9a-f]{40}$'; then
        echo 'immutable 40-character repo SHA required' >&2
        exit 64
      fi
      sha="$1"
      repo=/opt/chess-studio/repo
      test -d "$repo/.git"
      cd "$repo"
      git fetch --no-tags --depth=1 origin "$sha"
      git checkout --detach "$sha"
      docker build -t chess-studio-backend:oci backend-python
      if [ ! -s /etc/chess-studio/backend.env ]; then
        echo 'CHESS_STUDIO_RUNTIME_ENV_MISSING' >&2
        exit 42
      fi
      systemctl daemon-reload
      systemctl restart chess-studio-backend.service
      for attempt in $(seq 1 60); do
        if curl --fail --silent --show-error --max-time 5 http://127.0.0.1:4000/api/ready >/dev/null; then
          printf '%s\n' "CHESS_STUDIO_DEPLOY_OK repo_ref=$sha"
          exit 0
        fi
        sleep 2
      done
      echo 'CHESS_STUDIO_READY_TIMEOUT' >&2
      exit 43

  - path: /usr/local/sbin/chess-studio-install-runtime
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      if [ "$#" -ne 1 ]; then
        echo 'runtime source path required' >&2
        exit 64
      fi
      src="$1"
      case "$src" in
        /tmp/chess-studio-backend.env.*) ;;
        *) echo 'refusing unexpected runtime source path' >&2; exit 64 ;;
      esac
      if [ ! -f "$src" ] || [ -L "$src" ]; then
        echo 'runtime source must be a regular non-symlink file' >&2
        exit 65
      fi
      install -o root -g root -m 0600 "$src" /etc/chess-studio/backend.env
      rm -f "$src"
      printf '%s\n' 'CHESS_STUDIO_RUNTIME_ENV_READY'

  - path: /etc/sudoers.d/101-chess-studio-ocarun
    owner: root:root
    permissions: '0440'
    content: |
      Cmnd_Alias CHESS_STUDIO_DEPLOY = /usr/local/sbin/chess-studio-deploy *
      Cmnd_Alias CHESS_STUDIO_RUNTIME = /usr/local/sbin/chess-studio-install-runtime /tmp/chess-studio-backend.env.*
      ocarun ALL=(root) NOPASSWD: CHESS_STUDIO_DEPLOY, CHESS_STUDIO_RUNTIME

  - path: /etc/systemd/system/chess-studio-backend.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Chess Studio backend container
      Wants=network-online.target
      After=network-online.target docker.service
      Requires=docker.service
      ConditionPathExists=/etc/chess-studio/backend.env

      [Service]
      Type=simple
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f chess-studio-backend
      ExecStart=/usr/bin/docker run --name chess-studio-backend --env-file /etc/chess-studio/backend.env -p 127.0.0.1:4000:4000 chess-studio-backend:oci
      ExecStop=/usr/bin/docker stop -t 20 chess-studio-backend

      [Install]
      WantedBy=multi-user.target

  - path: /etc/chess-studio/README
    owner: root:root
    permissions: '0644'
    content: |
      Terraform deliberately writes no production secrets.
      Provision /etc/chess-studio/backend.env out-of-band with mode 0600,
      configure Cloudflare Tunnel credentials out-of-band, then run:

        systemctl start chess-studio-backend

      FastAPI is bound only to 127.0.0.1:4000 on the host.

runcmd:
  - [ mkdir, -p, /opt/chess-studio, /etc/chess-studio ]
  - [ visudo, -cf, /etc/sudoers.d/101-chess-studio-ocarun ]
  - [ systemctl, enable, --now, docker ]
  - [ git, clone, "${repo_url}", /opt/chess-studio/repo ]
  - [ bash, -lc, "cd /opt/chess-studio/repo && git checkout --detach '${repo_ref}'" ]
  - [ docker, build, -t, chess-studio-backend:oci, /opt/chess-studio/repo/backend-python ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, chess-studio-backend.service ]
  - [ bash, -lc, "printf '%s\n' 'CHESS_STUDIO_BOOTSTRAP_READY repo_ref=${repo_ref}' | tee /opt/chess-studio/BOOTSTRAP_READY /dev/console >/dev/null" ]
